# Safe local defaults. Standalone commands deliberately load .env.local.
# Keep real keys in .env.local, never in committed files.
DEPLOYMENT_MODE=local
DATABASE_PATH=.data/hindsight.sqlite
PRIVATE_CACHE_DIR=.data/nansen-cache

# setup must generate and persist a random local session secret if unset.
# Production must reject a missing/default secret.
SESSION_SECRET=

# Provider commands also require positive local and command credit caps.
NANSEN_API_KEY=
NANSEN_MAX_CREDITS=0
NANSEN_REQUEST_TIMEOUT_MS=60000
NANSEN_MAX_RETRIES=1
NANSEN_CONCURRENCY=1
NANSEN_MIN_INTERVAL_MS=1000
NANSEN_PRICE_SOURCE=standard_ohlcv

# A technical flag is not legal clearance; require documented approval.
PUBLIC_NANSEN_DISPLAY_APPROVED=false

# Illustrative simulation assumptions, frozen in every round.
EXPERIMENT_CHAIN=ethereum
EXPERIMENT_HISTORY_DAYS=30
EXPERIMENT_EVIDENCE_DAYS=7
EXPERIMENT_HOLD_DAYS=7
EXPERIMENT_AVAILABILITY_LAG_HOURS=24
EXPERIMENT_CAPITAL_USD=1000
EXPERIMENT_FEE_BPS=10
EXPERIMENT_SLIPPAGE_BPS=25
