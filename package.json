{
  "name": "hindsight",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/main.ts",
    "start": "bun src/server/main.ts --production",
    "setup": "bun scripts/setup.ts",
    "doctor": "bun scripts/doctor.ts",
    "build": "vite build",
    "lint": "oxlint . && oxfmt --check",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:e2e": "bun run build && playwright test",
    "smoke:nansen": "bun scripts/smoke-nansen.ts",
    "data:prepare-one": "bun scripts/prepare-one.ts",
    "data:build": "bun scripts/build-corpus.ts",
    "usage:report": "bun scripts/usage-report.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "5.2.0",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "bun": "1.4.1"
  },
  "packageManager": "bun@1.4.1"
}
